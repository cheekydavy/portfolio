%% POS platform architecture. Components and groups follow the supplied GitDiagram reference;
%% relationships were checked against the source code.
flowchart TD

subgraph group_interface["Operator interface"]
  node_pos["POS checkout"]
  node_inbox["Message inbox"]
  node_reports_ui["Reports screens"]
  node_backoffice["Back-office screens"]
end

subgraph group_finance["Sales and finance"]
  node_sales_service["Sales and receivables"]
  node_sales_controller["Sales API handlers"]
  node_mpesa_service["M-Pesa payments"]
  node_mpesa_client["Daraja client"]
  node_reports_sales["Reporting services"]
  node_reports_general["General reports"]
end

subgraph group_operations["Catalog and operations"]
  node_products["Product catalog"]
  node_inventory["Inventory ledger"]
  node_purchasing["Purchase orders"]
  node_customers["Customer records"]
  node_branches["Branch management"]
  node_suppliers["Supplier records"]
end

subgraph group_comms["Customer communications"]
  node_whatsapp["WhatsApp messaging"]
  node_storage["Attachment storage"]
end

subgraph group_platform["API platform"]
  node_auth["Authentication"]
  node_roles["Roles and permissions"]
  node_users["User management"]
  node_database[("PostgreSQL through Prisma")]
  node_audit["Audit logging"]
  node_env["Runtime configuration"]
  node_pagination["Pagination utilities"]
  node_logger["API logger"]
end

node_staff(("Staff user"))
node_safaricom{{"Safaricom Daraja"}}
node_meta{{"Meta WhatsApp"}}

node_staff -->|"takes sales"| node_pos
node_staff -->|"answers customers"| node_inbox
node_staff -->|"reviews reports"| node_reports_ui
node_staff -->|"runs the business"| node_backoffice
node_staff -->|"signs in"| node_auth

node_pos -->|"submits sales"| node_sales_controller
node_pos -->|"requests M-Pesa payment"| node_mpesa_service
node_inbox -->|"reads and replies"| node_whatsapp
node_reports_ui -->|"requests sales reports"| node_reports_sales
node_reports_ui -->|"requests stock and purchase reports"| node_reports_general
node_backoffice -->|"manages catalog"| node_products
node_backoffice -->|"adjusts stock"| node_inventory
node_backoffice -->|"manages purchasing"| node_purchasing
node_backoffice -->|"manages customers"| node_customers
node_backoffice -->|"manages branches"| node_branches
node_backoffice -->|"manages suppliers"| node_suppliers
node_backoffice -->|"manages staff"| node_users
node_backoffice -->|"edits roles"| node_roles

node_sales_controller -->|"calls"| node_sales_service
node_sales_service -.->|"deducts stock"| node_inventory
node_sales_service -.->|"requires a customer for credit"| node_customers
node_sales_service -.->|"persists sales"| node_database
node_sales_service -.->|"records actions"| node_audit
node_pagination -.->|"paginates sales lists"| node_sales_service

node_mpesa_service -->|"sends requests"| node_mpesa_client
node_mpesa_client -->|"STK push and status query"| node_safaricom
node_safaricom -->|"sends callback"| node_mpesa_service
node_mpesa_service -->|"applies confirmed payment"| node_sales_service
node_mpesa_service -.->|"stores transactions"| node_database
node_env -.->|"supplies Daraja settings"| node_mpesa_client
node_logger -.->|"redacted logging"| node_mpesa_service

node_reports_sales -.->|"reads sales and receivables"| node_database
node_reports_general -.->|"reads stock and purchases"| node_database

node_purchasing -.->|"posts receipts"| node_inventory
node_purchasing -.->|"orders from"| node_suppliers
node_products -.->|"stores catalog"| node_database
node_inventory -.->|"appends movements"| node_database
node_purchasing -.->|"stores orders"| node_database
node_customers -.->|"stores customers"| node_database
node_branches -.->|"stores branches"| node_database
node_suppliers -.->|"stores suppliers"| node_database

node_whatsapp -->|"sends and receives"| node_meta
node_meta -->|"signed webhook"| node_whatsapp
node_whatsapp -.->|"stores media"| node_storage
node_whatsapp -.->|"links chats to"| node_customers
node_whatsapp -.->|"reads balances and invoices"| node_sales_service
node_whatsapp -.->|"stores conversations"| node_database
node_whatsapp -.->|"records actions"| node_audit
node_pagination -.->|"paginates conversations"| node_whatsapp
node_env -.->|"supplies Meta settings"| node_whatsapp
node_env -.->|"supplies storage settings"| node_storage
node_logger -.->|"redacted logging"| node_whatsapp

node_users -.->|"assigns roles"| node_roles
node_auth -.->|"checks accounts"| node_database
node_roles -.->|"stores permissions"| node_database
node_users -.->|"stores accounts"| node_database
node_audit -.->|"append-only log"| node_database

class node_pos,node_inbox,node_reports_ui,node_backoffice,node_staff toneBlue
class node_sales_service,node_sales_controller,node_mpesa_service,node_mpesa_client,node_reports_sales,node_reports_general toneAmber
class node_products,node_inventory,node_purchasing,node_customers,node_branches,node_suppliers toneMint
class node_whatsapp,node_storage toneTeal
class node_auth,node_roles,node_users,node_database,node_audit,node_env,node_pagination,node_logger toneRose
